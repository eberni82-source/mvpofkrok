# Copy to .env; never commit .env. npm run dev loads this file.
# For local SQLite, keep DATABASE_URL commented out.
# DATABASE_URL=postgresql://cursor:YOUR_PASSWORD@127.0.0.1:5432/cursor
# POSTGRES_PASSWORD=choose-a-long-unique-password
# Local default:
CURSOR_ENV=development
CURSOR_ALLOWED_HOSTS=localhost,127.0.0.1
# Hosting: set these in the platform Variables, not in Git:
# CURSOR_ENV=production
# CURSOR_ALLOWED_HOSTS=your-app.up.railway.app
# CURSOR_PUBLIC_ORIGIN=https://your-app.up.railway.app
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# PostgreSQL tables stay in a private, unexposed schema (Supabase compatible).
CURSOR_DB_SCHEMA=cursor_app
# Supabase: use the exact Direct or Session pooler URL from Connect.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Do not add cursor_app to Supabase Exposed schemas. No API keys belong in frontend.
